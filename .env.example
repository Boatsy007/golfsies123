# Copy to .env.local for local development, and add the same variables in Vercel
# (Project → Settings → Environment Variables). Never commit real values.

# Where claim and partner forms are delivered: any URL that accepts a JSON POST,
# e.g. a Formspree form endpoint, a Zapier/Make webhook or a Google Apps Script.
# Server-only: it is never sent to the browser.
ENQUIRY_WEBHOOK_URL=

# Set to 1 to accept submissions without sending them anywhere (local testing only).
ENQUIRY_DRY_RUN=
